# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase (service role — server only) ---
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# --- Supabase (browser — public, used by the dashboard/portal login + authedFetch) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# --- Per-brand integration credentials (Sprint 6.1) ---
# AES-256-GCM key for encrypting third-party integration credentials
# (lib/crypto.ts) before they're stored in brand_integrations. Only needed
# once a provider integration starts calling upsertIntegrationCredentials().
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=...

# --- Google Search Console (service account added to the GSC property) ---
GSC_CLIENT_EMAIL=agent@yourproject.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- DataForSEO (search volume, keyword difficulty, search intent, domain/backlink data) ---
# Without these, rank_enrich fails clearly instead of silently writing no data.
DATAFORSEO_LOGIN=...
DATAFORSEO_PASSWORD=...

# --- AI visibility (GEO/AEO) — which assistants recommend the brand ---
# Every assistant is OPTIONAL. Configure none and the weekly sweep is skipped;
# configure one and it works; configure more and the report widens. Nothing else
# in the platform changes either way.
#
# claude        -> ANTHROPIC_API_KEY (already set above)
# gemini        -> GEMINI_API_KEY (already used for post images, below)
# ai_overview   -> DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD (already set above)
# openai        -> OPENAI_API_KEY (new vendor)
# perplexity    -> PERPLEXITY_API_KEY (new vendor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Cost controls. Every check is a web-search-grounded model call — the most
# expensive call the platform makes — so a sweep is prompts x assistants of them.
# Start low and raise once you have seen a real bill.
AI_VISIBILITY_ASSISTANTS=            # comma-separated ids to narrow the set; empty = all configured
AI_VISIBILITY_PROMPTS_PER_RUN=12     # distinct questions per sweep
AI_VISIBILITY_CHECKS_PER_STEP=6      # (prompt x assistant) checks per queue job
AI_VISIBILITY_MAX_LOCALES=6          # places measured per brand
AI_VISIBILITY_STEP_BUDGET_MS=40000   # wall clock per queue job, under the 60s function limit
AI_VISIBILITY_MULTILINGUAL=0         # 1 = also ask in the country's other official languages

# --- Autonomy controls ---
CRON_SECRET=make-a-long-random-string
NEXT_PUBLIC_CRON_SECRET=same-as-CRON_SECRET   # lets the dashboard "Run now" button call the cron
MAX_TASKS_PER_RUN=4
AUTO_PUBLISH=false   # true = auto-publish low-risk meta fixes without review
MANUAL_RUN_COOLDOWN_MINUTES=15   # min minutes between a customer's manual "Run agents now" triggers per brand; admins are exempt (Sprint 6.10)
