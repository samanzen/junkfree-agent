# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase (service role — server only) ---
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# --- Supabase (browser — public, used by the dashboard/portal login + authedFetch) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# --- Per-brand integration credentials (Sprint 6.1) ---
# AES-256-GCM key for encrypting third-party integration credentials
# (lib/crypto.ts) before they're stored in brand_integrations. Only needed
# once a provider integration starts calling upsertIntegrationCredentials().
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=...

# --- Google Search Console (service account added to the GSC property) ---
GSC_CLIENT_EMAIL=agent@yourproject.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google OAuth (customer Search Console / Analytics / Business Profile) ---
# Used by /api/portal/google/* for per-brand connects. Without these, Google
# product cards stay disconnected in the portal.
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Optional absolute origin for OAuth redirects (defaults to request origin).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Stripe (optional — self-serve checkout; leave unset for trial/managed) ---
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_FOUNDING=price_...
# STRIPE_PRICE_GROWTH=price_...

# --- DataForSEO (search volume, keyword difficulty, search intent, domain/backlink data) ---
# Without these, rank_enrich fails clearly instead of silently writing no data.
DATAFORSEO_LOGIN=...
DATAFORSEO_PASSWORD=...

# --- Autonomy controls ---
# Server-only. Protects /api/cron/* (orchestrate, rank-sync, rank-enrich, prune).
# Never put this in a NEXT_PUBLIC_* variable — that would ship it in the browser
# bundle. Manual "Run agents now" uses the caller's Supabase session via /api/run.
CRON_SECRET=make-a-long-random-string
MAX_TASKS_PER_RUN=4
AUTO_PUBLISH=false   # true = auto-publish low-risk meta fixes without review
MANUAL_RUN_COOLDOWN_MINUTES=15   # min minutes between a customer's manual "Run agents now" triggers per brand; admins are exempt (Sprint 6.10)
